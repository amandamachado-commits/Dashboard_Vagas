# Copie este arquivo para ".env" (uso local) e preencha.
# No Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# NUNCA versionar o arquivo .env.

SHEET_ID=COLE_AQUI_O_ID_DA_PLANILHA_DE_VAGAS
SHEET_ID_TURNOVER=COLE_AQUI_O_ID_DA_PLANILHA_DE_TURNOVER
DASHBOARD_USER=gente-e-gestao
DASHBOARD_PASSWORD=troque-por-uma-senha-forte

# Use "mdy" só se as datas vierem no formato mês/dia/ano
DATE_ORDER=dmy
